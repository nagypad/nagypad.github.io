---
import Fejlec from "../components/Fejlec.astro";
import Lablab from "../components/Lablab.astro";
import "../styles/global.css";

interface Props {
  title: string;
  leiras?: string;
  /** Abszolút kép-URL az OG/Twitter kártyához (fallback: a logó). */
  ogKep?: string;
  ogTipus?: "website" | "article";
  /** Koordináta az OG `place` mezőhöz, ha a lapnak van helye. */
  koordinata?: readonly [number, number];
  kozzetett?: Date;
  noindex?: boolean;
}

const {
  title,
  leiras = "Padok a világ minden tájáról — fotók, helyszínek, történetek.",
  ogKep,
  ogTipus = "website",
  koordinata,
  kozzetett,
  noindex = false,
} = Astro.props;

const oldalCim =
  title === "Nagy Pad Projekt" ? title : `${title} · Nagy Pad Projekt`;
const kanonikusUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogKepUrl = ogKep ?? new URL("/logo.svg", Astro.site).toString();
---

<!doctype html>
<html lang="hu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{oldalCim}</title>
    <meta name="description" content={leiras} />
    <link rel="canonical" href={kanonikusUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:title" content={oldalCim} />
    <meta property="og:description" content={leiras} />
    <meta property="og:url" content={kanonikusUrl} />
    <meta property="og:type" content={ogTipus} />
    <meta property="og:locale" content="hu_HU" />
    <meta property="og:site_name" content="Nagy Pad Projekt" />
    <meta property="og:image" content={ogKepUrl} />
    {kozzetett && (
      <meta
        property="article:published_time"
        content={kozzetett.toISOString()}
      />
    )}
    {koordinata && (
      <>
        <meta
          property="place:location:latitude"
          content={String(koordinata[0])}
        />
        <meta
          property="place:location:longitude"
          content={String(koordinata[1])}
        />
      </>
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={oldalCim} />
    <meta name="twitter:description" content={leiras} />
    <meta name="twitter:image" content={ogKepUrl} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Nagy Pad Projekt — legfrissebb padok"
      href="/rss.xml"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Nagy Pad Projekt — a nap padja"
      href="/feed/napi-pad.xml"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Source+Sans+3:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Fejlec />
    <main>
      <slot />
    </main>
    <Lablab />
  </body>
</html>
